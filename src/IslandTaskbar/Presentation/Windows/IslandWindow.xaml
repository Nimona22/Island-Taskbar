<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="IslandTaskbar.Presentation.Windows.IslandWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="IslandTaskbar">
    <!-- Phase 3.2: one native drawing/input surface; independent controls inside it. -->
    <Grid x:Name="WindowRoot" LayoutUpdated="OnSurfaceLayoutUpdated" KeyDown="OnPrototypeKeyDown">
        <Grid.Resources>
            <Style x:Key="PrototypeIconButton" TargetType="Button">
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Tag" Value="{StaticResource Surface.ControlHover}" />
                <Setter Property="Foreground" Value="{StaticResource Text.Primary}" />
                <Setter Property="CornerRadius" Value="{StaticResource Radius.Control}" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid>
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="InteractionWash.Opacity" Value="0.35" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="InteractionWash.Opacity" Value="0.65" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <VisualState.Setters>
                                                <Setter Target="ContentHost.Opacity" Value="0.5" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <Border Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}" />
                                <Border x:Name="InteractionWash" Background="{TemplateBinding Tag}"
                                        CornerRadius="{TemplateBinding CornerRadius}" Opacity="0" />
                                <ContentPresenter x:Name="ContentHost" Content="{TemplateBinding Content}"
                                                  HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="PrototypeMusicIconButton" TargetType="Button"
                   BasedOn="{StaticResource PrototypeIconButton}">
                <Setter Property="Tag" Value="{StaticResource Music.Control.Hover}" />
            </Style>
        </Grid.Resources>
        <Grid x:Name="IslandSurface" HorizontalAlignment="Center" VerticalAlignment="Top"
              Loaded="OnSurfaceLoaded">
            <Border x:Name="IdleSurface" Background="{StaticResource Surface.IslandFallback}"
                    BorderBrush="{StaticResource Border.Subtle}" BorderThickness="1"
                    CornerRadius="{StaticResource Radius.Notch}">
                <Grid>
            <Button x:Name="IslandToggle" Style="{StaticResource PrototypeIconButton}"
                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                    AutomationProperties.AutomationId="IslandPrototypeToggle"
                    AutomationProperties.Name="Expand IslandTaskbar music; placeholder Tiles icon"
                    ToolTipService.ToolTip="Expand IslandTaskbar" Click="OnIslandToggleClick">
                <FontIcon x:Name="NotchIcon" FontFamily="Segoe Fluent Icons" Glyph="&#xECA5;"
                          FontSize="{StaticResource Type.Display.Size}"
                          HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" />
            </Button>
                </Grid>
            </Border>
            <Path x:Name="MusicSurface" Fill="{StaticResource Music.Surface}"
                  Stroke="{StaticResource Music.Border}" StrokeThickness="1"
                  IsHitTestVisible="False" Visibility="Collapsed" />

            <Grid x:Name="ExpandedContent" ColumnSpacing="{StaticResource Space.Compact}"
                  VerticalAlignment="Center" Opacity="0" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid Width="{StaticResource Music.Ring.Size}" Height="{StaticResource Music.Ring.Size}"
                      IsHitTestVisible="False">
                    <Canvas x:Name="IllustrativeRing" Width="{StaticResource Music.Ring.Size}"
                            Height="{StaticResource Music.Ring.Size}" RenderTransformOrigin="0.5,0.5" />
                    <Ellipse x:Name="AlbumDisc" Width="{StaticResource Music.Artwork.Size}"
                             Height="{StaticResource Music.Artwork.Size}"
                             Stroke="{StaticResource Music.Border}" StrokeThickness="1"
                             RenderTransformOrigin="0.5,0.5" />
                </Grid>
                <Grid Grid.Column="1" Width="{StaticResource Music.Waveform.Width}"
                      Height="{StaticResource Music.Ring.Size}">
                    <StackPanel x:Name="IllustrativeWaveform" Orientation="Horizontal"
                                Spacing="{StaticResource Music.Waveform.BarGap}"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                Height="{StaticResource Music.Waveform.Height}" IsHitTestVisible="False" />
                    <TextBlock x:Name="MusicStatus" Text="Demo"
                               AutomationProperties.AutomationId="MusicPrototypeStatus"
                               AutomationProperties.Name="{x:Bind MusicState.StatusText, Mode=OneWay}"
                               ToolTipService.ToolTip="Illustrative waveform and artwork; no audio playback"
                               Style="{StaticResource Type.Caption}"
                               Foreground="{StaticResource Music.Text.Secondary}"
                               HorizontalAlignment="Center" VerticalAlignment="Bottom" />
                </Grid>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                            Spacing="{StaticResource Space.Micro}">
                    <Button x:Name="PreviousButton" Style="{StaticResource PrototypeMusicIconButton}"
                            Width="{StaticResource Music.Control.Size}" Height="{StaticResource Music.Control.Height}"
                            Foreground="{StaticResource Music.Text.Primary}"
                            AutomationProperties.AutomationId="MusicPrototypePrevious"
                            AutomationProperties.Name="Previous track"
                            IsEnabled="{x:Bind MusicState.CanPrevious, Mode=OneWay}"
                            ToolTipService.ToolTip="Previous track" Click="OnPreviousClick">
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE892;"
                                  FontSize="{StaticResource Music.Control.IconSize}" />
                    </Button>
                    <Button x:Name="PlayPauseButton" Style="{StaticResource PrototypeMusicIconButton}"
                            Width="{StaticResource Music.Play.Size}" Height="{StaticResource Music.Play.Size}"
                            Background="{StaticResource Music.Play.Surface}" CornerRadius="{StaticResource Music.Play.Radius}"
                            AutomationProperties.AutomationId="MusicPrototypePlayPause"
                            AutomationProperties.Name="{x:Bind MusicState.PlayPauseName, Mode=OneWay}"
                            IsEnabled="{x:Bind MusicState.CanTogglePlayback, Mode=OneWay}"
                            AutomationProperties.HelpText="{x:Bind MusicState.StatusText, Mode=OneWay}"
                            ToolTipService.ToolTip="{x:Bind MusicState.PlayPauseName, Mode=OneWay}" Click="OnPlayPauseClick">
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="{x:Bind MusicState.PlayPauseGlyph, Mode=OneWay}"
                                  FontSize="{StaticResource Music.Control.IconSize}" />
                    </Button>
                    <Button x:Name="NextButton" Style="{StaticResource PrototypeMusicIconButton}"
                            Width="{StaticResource Music.Control.Size}" Height="{StaticResource Music.Control.Height}"
                            Foreground="{StaticResource Music.Text.Primary}"
                            AutomationProperties.AutomationId="MusicPrototypeNext"
                            AutomationProperties.Name="Next track"
                            IsEnabled="{x:Bind MusicState.CanNext, Mode=OneWay}"
                            ToolTipService.ToolTip="Next track" Click="OnNextClick">
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE893;"
                                  FontSize="{StaticResource Music.Control.IconSize}" />
                    </Button>
                </StackPanel>
                <Button x:Name="CollapseButton" Grid.Column="3" Style="{StaticResource PrototypeMusicIconButton}"
                        Width="{StaticResource Music.Collapse.Size}" Height="{StaticResource Music.Collapse.Size}"
                        VerticalAlignment="Center" Foreground="{StaticResource Music.Text.Secondary}"
                        AutomationProperties.AutomationId="IslandPrototypeCollapse"
                        AutomationProperties.Name="Return music to idle notch"
                        ToolTipService.ToolTip="Return to idle" Click="OnCollapseClick">
                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE70E;"
                              FontSize="{StaticResource Type.Caption.Size}" />
                </Button>
            </Grid>
        </Grid>
    </Grid>
</Window>
