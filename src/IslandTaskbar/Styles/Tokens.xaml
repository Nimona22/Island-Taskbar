<?xml version="1.0" encoding="utf-8"?>
<!--
    Design tokens from DESIGN_SYSTEM.md §3.3, §4.1, and §6.
    PROVISIONAL — OD-019 (exact dimensions/radii) and OD-020 (final dark palette, accent color, light theme) remain open.
    Motion tokens are intentionally omitted until OD-001 (animation model and timing) is resolved.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Spacing tokens (DESIGN_SYSTEM.md §3.3, DIP) -->
    <x:Double x:Key="Space.Micro">4</x:Double>
    <x:Double x:Key="Space.Compact">8</x:Double>
    <x:Double x:Key="Space.Standard">12</x:Double>
    <x:Double x:Key="Space.Section">16</x:Double>
    <x:Double x:Key="Space.Major">24</x:Double>

    <!-- Surface and color tokens (DESIGN_SYSTEM.md §4.1, provisional dark graphite glass) -->
    <SolidColorBrush x:Key="Surface.IslandFallback" Color="#17171B" />
    <SolidColorBrush x:Key="Surface.ElevatedFallback" Color="#222229" />
    <SolidColorBrush x:Key="Surface.ControlHover" Color="#303039" />

    <SolidColorBrush x:Key="Text.Primary" Color="#F5F5F7" />
    <SolidColorBrush x:Key="Text.Secondary" Color="#C2C2CC" />
    <SolidColorBrush x:Key="Text.Muted" Color="#92929E" />

    <SolidColorBrush x:Key="Border.Subtle" Color="#26FFFFFF" />
    <SolidColorBrush x:Key="Divider.Subtle" Color="#1AFFFFFF" />

    <SolidColorBrush x:Key="State.Success" Color="#45B879" />
    <SolidColorBrush x:Key="State.Warning" Color="#E6B450" />
    <SolidColorBrush x:Key="State.Error" Color="#E06B6B" />

    <SolidColorBrush x:Key="Accent.Platform" Color="{ThemeResource SystemAccentColor}" />

    <!-- Shape and corner-radius tokens (DESIGN_SYSTEM.md §6, provisional DIP values) -->
    <CornerRadius x:Key="Radius.Control">8</CornerRadius>
    <CornerRadius x:Key="Radius.Card">12</CornerRadius>
    <CornerRadius x:Key="Radius.Panel">16</CornerRadius>
    <!-- Top edge stays flush (0) while lower corners are rounded per DESIGN_SYSTEM.md §6 and CONVENTIONS.md §C.2 -->
    <CornerRadius x:Key="Radius.Island">0,0,22,22</CornerRadius>
    <CornerRadius x:Key="Radius.Notch">0,0,16,16</CornerRadius>

</ResourceDictionary>
