<?xml version="1.0" encoding="utf-8"?>
<!--
    Design tokens from DESIGN_SYSTEM.md §3.3, §4.1, and §6.
    PROVISIONAL — OD-019 (exact dimensions/radii) and OD-020 (final dark palette, accent color, light theme) remain open.
    Phase 3.1 motion is provisional; OD-001 remains open for the final product.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Spacing tokens (DESIGN_SYSTEM.md §3.3, DIP) -->
    <x:Double x:Key="Space.Micro">4</x:Double>
    <x:Double x:Key="Space.Compact">8</x:Double>
    <x:Double x:Key="Space.Standard">12</x:Double>
    <x:Double x:Key="Space.Section">16</x:Double>
    <x:Double x:Key="Space.Major">24</x:Double>
    <!-- PROVISIONAL Phase 3.1 only, DESIGN_SYSTEM.md section 9, milliseconds. -->
    <x:Double x:Key="Motion.Standard">220</x:Double>
    <!-- PROVISIONAL Phase 3.2 Music Mode, DESIGN_SYSTEM.md. -->
    <x:Double x:Key="Music.Control.Size">24</x:Double>
    <x:Double x:Key="Music.Control.Height">28</x:Double>
    <x:Double x:Key="Music.Control.IconSize">14</x:Double>
    <x:Double x:Key="Music.Play.Size">32</x:Double>
    <CornerRadius x:Key="Music.Play.Radius">16</CornerRadius>
    <x:Double x:Key="Music.Collapse.Size">24</x:Double>
    <x:Double x:Key="Music.Waveform.Height">22</x:Double>
    <x:Double x:Key="Music.Waveform.Width">42</x:Double>
    <x:Double x:Key="Music.Waveform.BarWidth">2</x:Double>
    <x:Double x:Key="Music.Waveform.BarGap">2</x:Double>
    <x:Double x:Key="Music.Waveform.BarRadius">1</x:Double>
    <x:Double x:Key="Music.Artwork.Size">40</x:Double>
    <x:Double x:Key="Music.Artwork.DecodeWidth">80</x:Double>
    <x:Double x:Key="Music.Ring.Size">52</x:Double>
    <x:Double x:Key="Music.Ring.StrokeThickness">1.3</x:Double>
    <x:Double x:Key="Music.Artwork.RotationSeconds">14</x:Double>
    <!-- Approved Phase 5.1 Taskbar Mode refinement; idle/Music aesthetics preserved. -->
    <x:Double x:Key="Taskbar.NotchIcon.Size">15</x:Double>
    <x:Double x:Key="Taskbar.Item.Width">76</x:Double>
    <x:Double x:Key="Taskbar.Item.Extent">80</x:Double>
    <x:Double x:Key="Taskbar.Item.Height">46</x:Double>
    <x:Double x:Key="Taskbar.Title.Width">68</x:Double>
    <x:Double x:Key="Taskbar.Icon.Size">20</x:Double>
    <x:Double x:Key="Taskbar.Indicator.ActiveWidth">20</x:Double>
    <x:Double x:Key="Taskbar.Row.Height">50</x:Double>
    <Thickness x:Key="Taskbar.Item.Margin">2,2,2,2</Thickness>
    <Thickness x:Key="Taskbar.Content.Margin">18,6,18,8</Thickness>
    <SolidColorBrush x:Key="Music.Text.Primary" Color="#F5F5F7" />
    <SolidColorBrush x:Key="Music.Text.Secondary" Color="#A8A8B3" />
    <SolidColorBrush x:Key="Music.Waveform.Fill" Color="#F9773D" />
    <SolidColorBrush x:Key="Music.Ring.Fill" Color="#ED936A" />
    <SolidColorBrush x:Key="Music.Border" Color="#38FFFFFF" />
    <SolidColorBrush x:Key="Music.Control.Hover" Color="#24B37D59" />
    <LinearGradientBrush x:Key="Music.Surface" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#14FFFFFF" Offset="0" />
        <GradientStop Color="#05000000" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Music.Play.Surface" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FF874C" Offset="0" />
        <GradientStop Color="#F56830" Offset="1" />
    </LinearGradientBrush>

    <!-- Surface and color tokens (DESIGN_SYSTEM.md §4.1, provisional dark graphite glass) -->
    <SolidColorBrush x:Key="Surface.IslandFallback" Color="#1A14141A" />
    <SolidColorBrush x:Key="Surface.ElevatedFallback" Color="#14202028" />
    <SolidColorBrush x:Key="Surface.ControlHover" Color="#303039" />

    <SolidColorBrush x:Key="Text.Primary" Color="#F5F5F7" />
    <SolidColorBrush x:Key="Text.Secondary" Color="#C2C2CC" />
    <SolidColorBrush x:Key="Text.Muted" Color="#92929E" />

    <SolidColorBrush x:Key="Border.Subtle" Color="#2EFFFFFF" />
    <SolidColorBrush x:Key="Divider.Subtle" Color="#1AFFFFFF" />

    <SolidColorBrush x:Key="State.Success" Color="#45B879" />
    <SolidColorBrush x:Key="State.Warning" Color="#E6B450" />
    <SolidColorBrush x:Key="State.Error" Color="#E06B6B" />

    <SolidColorBrush x:Key="Accent.Platform" Color="{ThemeResource SystemAccentColor}" />

    <!-- Shape and corner-radius tokens (DESIGN_SYSTEM.md §6, provisional DIP values) -->
    <CornerRadius x:Key="Radius.Control">8</CornerRadius>
    <CornerRadius x:Key="Radius.Card">12</CornerRadius>
    <CornerRadius x:Key="Radius.Panel">16</CornerRadius>
    <!-- Top edge stays flush (0) while lower corners are rounded per DESIGN_SYSTEM.md §6 and CONVENTIONS.md §C.2 -->
    <CornerRadius x:Key="Radius.Notch">0,0,12,12</CornerRadius>
    <CornerRadius x:Key="Radius.Island">0,0,24,24</CornerRadius>

</ResourceDictionary>
