<?xml version="1.0" encoding="utf-8"?>
<!--
    Typography tokens from DESIGN_SYSTEM.md §5.
    PROVISIONAL — sizes and weights must be verified across 100% through 200% DPI scaling (D-008)
    and coordinated with final brand typography (OD-021).
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- System UI typeface per DESIGN_SYSTEM.md §5 (no bundled custom font) -->
    <FontFamily x:Key="Type.FontFamily">Segoe UI Variable, Segoe UI</FontFamily>

    <!-- Provisional type scale (DESIGN_SYSTEM.md §5, DIP) -->
    <x:Double x:Key="Type.Display.Size">18</x:Double>
    <x:Double x:Key="Type.ControlLabel.Size">13</x:Double>
    <x:Double x:Key="Type.Body.Size">13</x:Double>
    <x:Double x:Key="Type.Caption.Size">11</x:Double>

    <Style x:Key="Type.Display" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Type.FontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource Type.Display.Size}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="Type.ControlLabel" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Type.FontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource Type.ControlLabel.Size}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="Type.Body" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Type.FontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource Type.Body.Size}" />
        <Setter Property="FontWeight" Value="Normal" />
    </Style>

    <Style x:Key="Type.Caption" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Type.FontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource Type.Caption.Size}" />
        <Setter Property="FontWeight" Value="Normal" />
    </Style>

</ResourceDictionary>
